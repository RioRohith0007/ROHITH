{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "command": "fnm",
            "args": ["exec", "--using=22", "npm.cmd", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Local:"
                }
            },
            "label": "npm: dev"
        }
    ]
}
